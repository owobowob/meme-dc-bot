# Bot 啟動必填。測試伺服器 ID 選填，留空會同步全域斜線指令。
DISCORD_BOT_TOKEN=
DISCORD_TEST_GUILD_ID=

# 聊天分析供應商可設 gemini 或 openai。
LLM_PROVIDER=gemini

# Gemini 聊天分析、圖片分析及 MyGO 正式匯入需要 Gemini 金鑰。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Gemini 備援模型可用逗號分隔。
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# 選用 OpenAI 聊天分析時需填寫金鑰。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SQLite 相對路徑以專案根目錄為準，圖片主機用逗號分隔。
DATABASE_PATH=data/memes.db
IMAGE_HOSTS=upload.wikimedia.org,i.imgur.com,i.imgflip.com,storageapi.miyago9267.com

# 選填。優先使用 MemeStack，有設定金鑰時會選用它作為即時外部搜尋服務。
MEMESTACK_API_KEY=
# 未設定 MemeStack 金鑰時，可提供聯絡資訊啟用 Wikimedia Commons 搜尋。
WIKIMEDIA_CONTACT=
# 保留欄位，目前未使用。
GIPHY_API_KEY=

# MyGO 匯入端點，可用 CLI 的 --api-url 覆蓋。
MYGO_API_URL=https://mygo.miyago9267.com/api/v1/images
